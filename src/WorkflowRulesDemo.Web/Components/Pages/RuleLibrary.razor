@page "/rules"
@inject RuleService RuleSvc

<PageTitle>规则库</PageTitle>

<Card HeaderText="规则库">
    <BodyTemplate>
        <p class="text-muted">
            独立管理规则定义（条件组 AND/OR 嵌套 + 命中动作），可在流程设计器的 RuleActivity 节点中复用。
        </p>
        <Button Text="+ 新建规则" Color="Color.Primary" OnClick="() => OpenEditor(null)" />

        <table class="table table-striped align-middle mt-3">
            <thead>
                <tr>
                    <th>名称</th>
                    <th>描述</th>
                    <th>条件</th>
                    <th>命中动作</th>
                    <th style="width:180px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rule in _rules)
                {
                    <tr>
                        <td>@rule.Name</td>
                        <td>@rule.Description</td>
                        <td><code>@Describe(rule.ConditionGroup)</code></td>
                        <td>@string.Join("; ", rule.Actions.Select(a => $"{a.Field}={a.Value}"))</td>
                        <td>
                            <Button Text="编辑" Size="Size.ExtraSmall" Color="Color.Secondary" OnClick="() => OpenEditor(rule)" />
                            <Button Text="删除" Size="Size.ExtraSmall" Color="Color.Danger" OnClick="() => DeleteAsync(rule)" />
                        </td>
                    </tr>
                }
                @if (_rules.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted">暂无规则，点击上方按钮新建。</td></tr>
                }
            </tbody>
        </table>
    </BodyTemplate>
</Card>

@if (_editing is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_isNew ? "新建规则" : "编辑规则")</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                </div>
                <div class="modal-body">
                    <RuleFieldsEditor Rule="_editing!" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditor">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync">保存</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RuleDefinition> _rules = new();
    private RuleDefinition? _editing;
    private bool _isNew;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _rules = await RuleSvc.GetAllAsync();
    }

    private void OpenEditor(RuleDefinition? rule)
    {
        _isNew = rule is null;
        _editing = rule is null
            ? new RuleDefinition()
            : new RuleDefinition
            {
                Id = rule.Id,
                Name = rule.Name,
                Description = rule.Description,
                ConditionGroup = Clone(rule.ConditionGroup),
                Actions = rule.Actions.Select(a => new RuleAction { Field = a.Field, Value = a.Value }).ToList()
            };
    }

    private void CloseEditor() => _editing = null;

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        await RuleSvc.SaveAsync(_editing);
        _editing = null;
        await ReloadAsync();
    }

    private async Task DeleteAsync(RuleDefinition rule)
    {
        await RuleSvc.DeleteAsync(rule.Id);
        await ReloadAsync();
    }

    private static ConditionGroup Clone(ConditionGroup group)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(group);
        return System.Text.Json.JsonSerializer.Deserialize<ConditionGroup>(json) ?? new ConditionGroup();
    }

    private static string Describe(ConditionGroup group)
    {
        var parts = new List<string>();
        parts.AddRange(group.Rules.Select(r => $"{r.Field} {DescribeOp(r.Operator)} {r.Value}"));
        parts.AddRange(group.Groups.Select(g => $"({Describe(g)})"));
        var op = group.Logic == LogicOperator.And ? " AND " : " OR ";
        return parts.Count == 0 ? "(空)" : string.Join(op, parts);
    }

    private static string DescribeOp(CompareOperator op) => op switch
    {
        CompareOperator.Equals => "==",
        CompareOperator.NotEquals => "!=",
        CompareOperator.GreaterThan => ">",
        CompareOperator.LessThan => "<",
        CompareOperator.GreaterOrEqual => ">=",
        CompareOperator.LessOrEqual => "<=",
        CompareOperator.Contains => "contains",
        _ => op.ToString()
    };
}
