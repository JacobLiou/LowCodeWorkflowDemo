@* 条件组构建器：递归编辑 AND/OR 嵌套的条件树。*@
<div class="border rounded p-2 mb-2" style="background:#f8f9fa;">
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <span class="fw-bold">分组逻辑:</span>
        <select class="form-select form-select-sm w-auto" @bind="Group.Logic">
            <option value="@LogicOperator.And">AND（且，全部满足）</option>
            <option value="@LogicOperator.Or">OR（或，任一满足）</option>
        </select>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddRule">+ 条件</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddGroup">+ 子分组</button>
        @if (OnRemove.HasDelegate)
        {
            <button type="button" class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => OnRemove.InvokeAsync()">删除本分组</button>
        }
    </div>

    @foreach (var rule in Group.Rules.ToList())
    {
        <div class="row g-2 align-items-center mb-1">
            <div class="col-3">
                <input class="form-control form-control-sm" placeholder="字段名，如 days" @bind="rule.Field" />
            </div>
            <div class="col-3">
                <select class="form-select form-select-sm" @bind="rule.Operator">
                    <option value="@CompareOperator.Equals">== 等于</option>
                    <option value="@CompareOperator.NotEquals">!= 不等于</option>
                    <option value="@CompareOperator.GreaterThan">&gt; 大于</option>
                    <option value="@CompareOperator.LessThan">&lt; 小于</option>
                    <option value="@CompareOperator.GreaterOrEqual">&gt;= 大于等于</option>
                    <option value="@CompareOperator.LessOrEqual">&lt;= 小于等于</option>
                    <option value="@CompareOperator.Contains">contains 包含</option>
                </select>
            </div>
            <div class="col-4">
                <input class="form-control form-control-sm" placeholder="值" @bind="rule.Value" />
            </div>
            <div class="col-2">
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Group.Rules.Remove(rule)">移除</button>
            </div>
        </div>
    }

    @if (Group.Groups.Count > 0)
    {
        <div class="ms-3 mt-2">
            @foreach (var sub in Group.Groups.ToList())
            {
                <ConditionGroupEditor Group="sub" OnRemove="EventCallback.Factory.Create(this, () => RemoveSubGroup(sub))" />
            }
        </div>
    }

    @if (Group.Rules.Count == 0 && Group.Groups.Count == 0)
    {
        <div class="text-muted small">（空分组，视为始终满足；点击“+ 条件”添加规则）</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ConditionGroup Group { get; set; } = new();
    [Parameter] public EventCallback OnRemove { get; set; }

    private void AddRule() => Group.Rules.Add(new ConditionRule());

    private void AddGroup() => Group.Groups.Add(new ConditionGroup());

    private void RemoveSubGroup(ConditionGroup sub) => Group.Groups.Remove(sub);
}
